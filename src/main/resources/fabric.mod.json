{
	"schemaVersion": 1,
	"id": "safe-quit",
	"version": "${version}",
	"name": "Safe Quit",
	"description": "Prevents game freezes and data corruption by ensuring singleplayer worlds finish saving before quitting.",
	"authors": [
		"ProHacker888"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/sq",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/safe-quit/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.sq.client.SafeQuitClient"
		]
	},
	"mixins": [
		{
			"config": "safe-quit.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}